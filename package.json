{
  "name": "js_playground",
  "version": "1.0.0",
  "description": "Experiments in JS - code should be seen as sandbox futilities.",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node build.js",
    "vendor": "node vendor.js",
    "serve": "node docs/dev-server.js docs",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "lint:html": "html-validate docs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "bootstrap": "4.5.0",
    "cheerio": "^1.2.0",
    "easytimer.js": "4.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "finalhandler": "^2.1.1",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "jquery": "3.7.1",
    "konva": "10.9.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "serve-static": "^2.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorrosenberg/js_playground.git"
  },
  "keywords": [
    "sandbox"
  ],
  "author": "Igor Rosenberg",
  "bugs": {
    "url": "https://github.com/igorrosenberg/js_playground/issues"
  },
  "homepage": "https://github.com/igorrosenberg/js_playground"
}
